[Desktop Entry]
Type=Application
Name=Sysi Overlay
Comment=Transparent system widgets, notes, and timer
Exec=sysi
Icon=io.sysi.Overlay
Terminal=false
Categories=Utility;System;
StartupNotify=false
Actions=Toggle;Quit;

[Desktop Action Toggle]
Name=Toggle Interaction
Exec=sysi --toggle

[Desktop Action Quit]
Name=Quit
Exec=sysi --quit
